# ---------------------------------------------------------------------------
# Future Scotty — environment
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
# Every value here is read on the SERVER ONLY. Nothing in this file is ever
# prefixed with NEXT_PUBLIC_, so nothing here can reach the browser bundle.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local docker-compose default. Railway/Neon/Supabase will give you their own.
DATABASE_URL="postgresql://future_scotty:future_scotty@localhost:5432/future_scotty?schema=public"

# --- Mode ------------------------------------------------------------------
# true  = use the built-in mock bank. No real token needed. Safe for development.
# false = talk to the real Up API using UP_API_TOKEN.
USE_MOCK_DATA="true"

# --- Up Bank ---------------------------------------------------------------
# Personal access token from https://api.up.com.au/getting_started
# Starts with "up:yeah:". Server-side only. Never logged, never stored in the
# database, never sent to the browser.
UP_API_TOKEN=""

# The `secretKey` returned once when you create a webhook via POST /webhooks.
# Used to verify the X-Up-Authenticity-Signature header on incoming events.
UP_WEBHOOK_SECRET=""

# --- Authentication --------------------------------------------------------
# 32+ random bytes used to sign the session cookie. Generate with:
#   npm run gen-secret
AUTH_SECRET=""

# scrypt hash of your login password. Generate with:
#   npm run hash-password -- "your password here"
# Format: scrypt$N$r$p$<salt-b64url>$<hash-b64url>
APP_PASSWORD_HASH=""

# --- Notion (optional) -----------------------------------------------------
# Internal integration token from https://www.notion.so/my-integrations
# The app only ever READS from Notion.
NOTION_TOKEN=""
# The page ID of your wishlist page (e.g. "Wardrobe & Gear System").
# The 32-character id from the page URL, with or without dashes.
NOTION_PAGE_ID=""

# --- Claude (optional) -------------------------------------------------------
# API key from https://console.anthropic.com (Settings -> API Keys).
# Powers the AI-generated Today headline and Review narrative. Generated only
# on demand (a button), never on a schedule or on every sync — nothing here
# calls the API on its own.
ANTHROPIC_API_KEY=""

# Bearer token for the daily AI-insight cron trigger (POST /api/cron/ai-insights).
# Only needed in production, where a scheduled job calls this route once a day.
# Generate with: npm run gen-secret
CRON_SECRET=""

# --- App -------------------------------------------------------------------
# Used to build the webhook URL shown in Settings. No trailing slash.
APP_URL="http://localhost:3000"
